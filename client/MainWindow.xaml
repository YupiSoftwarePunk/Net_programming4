<Window x:Class="client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:client"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <DockPanel Grid.Row="0" Background="#2b5278" Height="50">
            <TextBlock Text="Чат" 
                       Foreground="White" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="15,0,0,0"/>
            
            <TextBlock Text="{Binding UserName}"
                       Foreground="LightBlue" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
            
            <TextBlock x:Name="OnlineCounter"
                       Text="{Binding OnlineUsers}"
                       Foreground="LightGreen" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="20,0,0,0"
                       DockPanel.Dock="Left"/>
            
            <Button Content="Погода"
                    Margin="100,0,0,0"
                    HorizontalAlignment="Center"
                    Click="WeatherClick"
                    Background="DarkBlue" Foreground="White"
                    FontWeight="Bold" BorderThickness="0"
                    Width="120" Height="40"/>   
            
            <Button x:Name="GetStatistics" Width="120" Height="40" HorizontalAlignment="Right"
                    Background="DarkOrange" Foreground="White"
                    Content="Статистика" FontWeight="Bold" BorderThickness="0"
                    Click="StatsClick" Margin="5"/>
            
        </DockPanel>


        <ListBox x:Name="MessagesList" 
                 Grid.Row="1" Margin="10"
                 Background="White" BorderBrush="#d1d1d1" BorderThickness="1"
                 Padding="10"
                 ItemsSource="{Binding Messages}"
                 FontSize="14">

        </ListBox>


        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10">
            <TextBox x:Name="MessageInputBox" Width="665" Height="40"
                     FontSize="14" Padding="8"
                     Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}"
                     Background="White" Foreground="Black"
                     BorderBrush="#2b5278" BorderThickness="2"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0"/>
            
            <Button Content="Отправить" Width="120" Height="40"
                    Click="SendMessageClick"
                    Background="#2b5278" Foreground="White"
                    FontWeight="Bold" BorderThickness="0" 
                    Cursor="Hand" IsDefault="True" >
            </Button>
        </StackPanel>

    </Grid>
</Window>
